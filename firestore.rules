rules_version = '2';

// ==========================================================================
// TAA Portal — Firestore Security Rules (v2)
// Paste into: Firebase Console → Firestore Database → Rules tab → Publish.
//
// Data model:
//   users/{uid}            — PRIVATE. Full profile (DOB, Aadhaar, phone,
//                             address, role, status). uid = Firebase Auth
//                             UID. Only the owner or an Admin can read it.
//   public_profiles/{uid}  — PUBLIC. Safe subset only (name, role, sport,
//                             district, photo). This is what public pages
//                             (directories, rankings, "your coach's name")
//                             read from — never `users`.
//   afi_uid_index/{afiUid} — write-once claim record, stops two people
//                             registering the same AFI UID. No sensitive data.
//   aadhaar_index/{hash}   — write-once claim record keyed by a SHA-256 hash
//                             of the Aadhaar number, stops duplicate Aadhaar
//                             registration without ever storing/reading the
//                             raw number from this collection.
// ==========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function callerRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return callerRole() == "Admin";
    }

    function isOfficialOrAdmin() {
      return callerRole() == "Official" || callerRole() == "Admin" || callerRole() == "Technical Chairman";
    }

    // A District role's own `users` doc carries which district they run —
    // read once per rule check, so a secretary is scoped to their own
    // district only. Hybrid model: self-service within your district,
    // central Admin keeps final say (Admin bypasses every check below).
    function isDistrictSecretaryFor(districtName) {
      return isSignedIn()
        && callerRole() == "District"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.district == districtName;
    }

    // An Academy account's own `users` doc carries which academy it runs (field `academy`).
    function isAcademySecretaryFor(academyName) {
      return isSignedIn()
        && callerRole() == "Academy"
        && academyName is string
        && academyName != ""
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.academy == academyName;
    }

    // ---- users: private profile + role -------------------------------
    // Date of birth is confirmed by TAA from the birth certificate, then locked. For an Athlete:
    //  - at registration the athlete can only start with dob_status "Pending" (never "Verified");
    //  - once Verified, the athlete can no longer change dob or anything to do with its proof;
    //  - before that, the athlete can change dob / the certificate, but only by putting it back to "Pending";
    //  - only an Admin can set "Verified" or write the verified_* / changed_* audit fields.
    function dobOwnerEditOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.role != "Athlete"
        || !changed.hasAny(["dob", "dob_status", "dob_proof_url", "dob_reject_reason", "dob_verified_by", "dob_verified_at", "dob_changed_from", "dob_changed_at", "dob_changed_by"])
        || (resource.data.get("dob_status", "") != "Verified"
            && request.resource.data.get("dob_status", "") == "Pending"
            && !changed.hasAny(["dob_verified_by", "dob_verified_at", "dob_changed_from", "dob_changed_at", "dob_changed_by"]));
    }

    match /users/{userId} {
      // Technical Chairman needs Officials' contact details (phone) to staff a
      // meet — scoped to Official records only, not every private user doc.
      // An Academy secretary reads only the athletes registered under their own academy.
      allow read: if isOwner(userId) || isAdmin() || isDistrictSecretaryFor(resource.data.district)
                  || isAcademySecretaryFor(resource.data.get("academy", ""))
                  || (callerRole() == "Technical Chairman" && resource.data.role == "Official");
      allow create: if (isOwner(userId)
                        && request.resource.data.role in ["Athlete", "Coach", "Official", "District"]
                        && !("password" in request.resource.data)
                        && (request.resource.data.role != "Athlete" || request.resource.data.get("dob_status", "") == "Pending")
                        && !request.resource.data.keys().hasAny(["dob_verified_by", "dob_verified_at", "dob_changed_from", "dob_changed_at", "dob_changed_by"]))
                    // Admin provisions institutional accounts (District secretaries,
                    // Technical Chairman, other Admins) that don't self-register —
                    // still never allowed to carry a plaintext password field.
                    || (isAdmin() && !("password" in request.resource.data));
      allow update: if isAdmin()
                    || (isOwner(userId)
                        && request.resource.data.role == resource.data.role
                        && !("password" in request.resource.data)
                        && dobOwnerEditOk())
                    // District secretaries may only flip status (approve/reject) for
                    // members of their own district — nothing else, no other district.
                    || (isDistrictSecretaryFor(resource.data.district)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]));
      allow delete: if isAdmin();
    }

    // ---- public_profiles: safe-to-show subset, world readable ---------
    match /public_profiles/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ---- registration claim indexes (no reads needed; create-once) ----
    match /afi_uid_index/{afiUid} {
      allow create: if !exists(/databases/$(database)/documents/afi_uid_index/$(afiUid));
      allow read, update, delete: if isAdmin();
    }
    match /aadhaar_index/{hash} {
      allow create: if !exists(/databases/$(database)/documents/aadhaar_index/$(hash));
      allow read, update, delete: if isAdmin();
    }

    // ---- officials: supplementary official/coach credential data ------
    match /officials/{docId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ---- public site content: anyone can read, only staff can write ---
    match /competitions/{docId}    { allow read: if true; allow write: if isOfficialOrAdmin(); }
    match /results/{docId}         { allow read: if true; allow write: if isOfficialOrAdmin(); }
    match /districts/{docId}       { allow read: if true; allow write: if isAdmin() || isDistrictSecretaryFor(docId); }
    match /gallery/{docId}         { allow read: if true; allow write: if isAdmin(); }
    match /media/{docId}           { allow read: if true; allow write: if isAdmin(); }
    match /press_articles/{docId}  { allow read: if true; allow write: if isAdmin(); }
    match /press_releases/{docId}  { allow read: if true; allow write: if isAdmin(); }
    match /circulars/{docId}       { allow read: if true; allow write: if isAdmin(); }

    // ---- contact form: anyone can submit, only Admin can read ---------
    match /contact_queries/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ---- site-wide CMS content (About text, executive body, etc.) -----
    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- meet entries -------------------------------------------------
    // One document per athlete per meet, id = "<meetId>__<athleteUid>", so an athlete can only
    // ever be entered once per meet - by their district OR their academy, not both.
    // `district` on an entry is the name of the ENTERING entity (a district, or an academy when
    // entityType == "Academy"); `homeDistrict` is always the athlete's own district.
    // Staff (Admin / Technical Chairman / Official) can read-write everything for imports and
    // BIB assignment. A District or Academy secretary can create, change and remove entries
    // ONLY for their own athletes, ONLY while the meet is open (competitions/{meetId}.isActive),
    // and can never set a BIB. A district secretary can also READ entries an academy made for
    // that district's athletes.
    function meetIsOpen(meetId) {
      return exists(/databases/$(database)/documents/competitions/$(meetId))
        && get(/databases/$(database)/documents/competitions/$(meetId)).data.get("isActive", false) == true;
    }

    function entryEntityIs(entityType, name) {
      return (entityType == "District" && isDistrictSecretaryFor(name))
          || (entityType == "Academy" && isAcademySecretaryFor(name));
    }

    function validEntry(d, docId) {
      return d.keys().hasOnly(["meetId", "meetTitle", "athleteUid", "afi_uid", "district", "entityType", "homeDistrict",
                               "surname", "full_name", "father_name", "gender", "dob", "ageCategory",
                               "ageGroup", "cutoff", "events", "bib", "submittedBy", "createdAt", "updatedAt"])
        && d.meetId is string && d.athleteUid is string
        && d.entityType in ["District", "Academy"]
        && docId == d.meetId + "__" + d.athleteUid
        && d.submittedBy == request.auth.uid
        && d.events is list && d.events.size() >= 1 && d.events.size() <= 10
        && get(/databases/$(database)/documents/users/$(d.athleteUid)).data.role == "Athlete"
        && d.homeDistrict == get(/databases/$(database)/documents/users/$(d.athleteUid)).data.district
        && d.get("dob", "") == get(/databases/$(database)/documents/users/$(d.athleteUid)).data.get("dob", "")
        && (d.entityType == "District"
              ? d.district == d.homeDistrict
              : d.district == get(/databases/$(database)/documents/users/$(d.athleteUid)).data.academy);
    }

    match /meet_entries/{docId} {
      // A district secretary reads every entry for their district's athletes (their own and any an
      // academy made); an academy secretary reads the entries their academy made. Queries must
      // filter on homeDistrict (district) or on district + entityType "Academy" (academy).
      allow read: if isAdmin()
                  || isDistrictSecretaryFor(resource.data.homeDistrict)
                  || (resource.data.entityType == "Academy" && isAcademySecretaryFor(resource.data.district));

      allow create: if isOfficialOrAdmin()
                    || (entryEntityIs(request.resource.data.entityType, request.resource.data.district)
                        && meetIsOpen(request.resource.data.meetId)
                        && validEntry(request.resource.data, docId)
                        && !("bib" in request.resource.data));

      allow update: if isOfficialOrAdmin()
                    || (entryEntityIs(resource.data.get("entityType", "District"), resource.data.district)
                        && request.resource.data.district == resource.data.district
                        && request.resource.data.entityType == resource.data.get("entityType", "District")
                        && request.resource.data.meetId == resource.data.meetId
                        && meetIsOpen(resource.data.meetId)
                        && validEntry(request.resource.data, docId)
                        && request.resource.data.get("bib", null) == resource.data.get("bib", null));

      allow delete: if isOfficialOrAdmin()
                    || (entryEntityIs(resource.data.get("entityType", "District"), resource.data.district)
                        && meetIsOpen(resource.data.meetId));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
