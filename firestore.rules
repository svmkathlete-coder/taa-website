rules_version = '2';

// ==========================================================================
// TAA Portal — Firestore Security Rules (v2)
// Paste into: Firebase Console → Firestore Database → Rules tab → Publish.
//
// Data model:
//   users/{uid}            — PRIVATE. Full profile (DOB, Aadhaar, phone,
//                             address, role, status). uid = Firebase Auth
//                             UID. Only the owner or an Admin can read it.
//   public_profiles/{uid}  — PUBLIC. Safe subset only (name, role, sport,
//                             district, photo). This is what public pages
//                             (directories, rankings, "your coach's name")
//                             read from — never `users`.
//   afi_uid_index/{afiUid} — write-once claim record, stops two people
//                             registering the same AFI UID. No sensitive data.
//   aadhaar_index/{hash}   — write-once claim record keyed by a SHA-256 hash
//                             of the Aadhaar number, stops duplicate Aadhaar
//                             registration without ever storing/reading the
//                             raw number from this collection.
// ==========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function callerRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return callerRole() == "Admin";
    }

    function isOfficialOrAdmin() {
      return callerRole() == "Official" || callerRole() == "Admin" || callerRole() == "Technical Chairman";
    }

    // A District role's own `users` doc carries which district they run —
    // read once per rule check, so a secretary is scoped to their own
    // district only. Hybrid model: self-service within your district,
    // central Admin keeps final say (Admin bypasses every check below).
    function isDistrictSecretaryFor(districtName) {
      return isSignedIn()
        && callerRole() == "District"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.district == districtName;
    }

    // ---- users: private profile + role -------------------------------
    match /users/{userId} {
      // Technical Chairman needs Officials' contact details (phone) to staff a
      // meet — scoped to Official records only, not every private user doc.
      allow read: if isOwner(userId) || isAdmin() || isDistrictSecretaryFor(resource.data.district)
                  || (callerRole() == "Technical Chairman" && resource.data.role == "Official");
      allow create: if (isOwner(userId)
                        && request.resource.data.role in ["Athlete", "Coach", "Official", "District"]
                        && !("password" in request.resource.data))
                    // Admin provisions institutional accounts (District secretaries,
                    // Technical Chairman, other Admins) that don't self-register —
                    // still never allowed to carry a plaintext password field.
                    || (isAdmin() && !("password" in request.resource.data));
      allow update: if isAdmin()
                    || (isOwner(userId)
                        && request.resource.data.role == resource.data.role
                        && !("password" in request.resource.data))
                    // District secretaries may only flip status (approve/reject) for
                    // members of their own district — nothing else, no other district.
                    || (isDistrictSecretaryFor(resource.data.district)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]));
      allow delete: if isAdmin();
    }

    // ---- public_profiles: safe-to-show subset, world readable ---------
    match /public_profiles/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ---- registration claim indexes (no reads needed; create-once) ----
    match /afi_uid_index/{afiUid} {
      allow create: if !exists(/databases/$(database)/documents/afi_uid_index/$(afiUid));
      allow read, update, delete: if isAdmin();
    }
    match /aadhaar_index/{hash} {
      allow create: if !exists(/databases/$(database)/documents/aadhaar_index/$(hash));
      allow read, update, delete: if isAdmin();
    }

    // ---- officials: supplementary official/coach credential data ------
    match /officials/{docId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ---- public site content: anyone can read, only staff can write ---
    match /competitions/{docId}    { allow read: if true; allow write: if isOfficialOrAdmin(); }
    match /results/{docId}         { allow read: if true; allow write: if isOfficialOrAdmin(); }
    match /districts/{docId}       { allow read: if true; allow write: if isAdmin() || isDistrictSecretaryFor(docId); }
    match /gallery/{docId}         { allow read: if true; allow write: if isAdmin(); }
    match /media/{docId}           { allow read: if true; allow write: if isAdmin(); }
    match /press_articles/{docId}  { allow read: if true; allow write: if isAdmin(); }
    match /press_releases/{docId}  { allow read: if true; allow write: if isAdmin(); }
    match /circulars/{docId}       { allow read: if true; allow write: if isAdmin(); }

    // ---- contact form: anyone can submit, only Admin can read ---------
    match /contact_queries/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ---- site-wide CMS content (About text, executive body, etc.) -----
    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- meet entry data imported from external entry-collection tools
    //      (e.g. the district/state meet Google-Sheet entry systems) ----
    match /meet_entries/{docId} {
      allow read: if isAdmin();
      allow write: if isOfficialOrAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
